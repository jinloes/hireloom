{
  "name": "hireloom",
  "description": "Your experience, beautifully told. A local-first AI resume studio.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "clippy:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@react-pdf/renderer": "^4.3.1",
    "lucide-react": "^0.468.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/node": "^24.3.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/user-event": "^14.6.1",
    "@playwright/test": "^1.55.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "pdfjs-dist": "^5.4.149",
    "vitest": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2"
  }
